<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>DormCheck</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.216825105344-8u3shs7jec0oaeo2gu5h6ls14a86i555</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.dormcheck.ios</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Dev live reload only: lets the WKWebView load the Vite dev server over
		     http on localhost (Simulator) or the Mac's LAN IP (physical device).
		     NSAllowsLocalNetworking covers loopback + private LAN ranges without
		     permitting arbitrary internet HTTP, so production https traffic stays
		     fully ATS-protected. No effect on release builds, which load bundled dist/. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>DormCheck uses your location only while you're using the app, to show walk times from where you are to your classes. DormCheck never tracks your location in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DormCheck uses your location while you're using the app to show walk times from where you are to your classes.</string>
	<key>NSCameraUsageDescription</key>
	<string>DormCheck uses your camera to take photos for your profile, dorm room setups, marketplace listings, and roommate posts.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>DormCheck uses your microphone only when you choose to send a voice message.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>DormCheck saves photos you take to your photo library so you can keep them.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>DormCheck accesses your photo library so you can add photos to your profile, dorm room setups, marketplace listings, and roommate posts.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
