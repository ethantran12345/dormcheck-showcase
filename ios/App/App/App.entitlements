<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: tapped https://dormcheck.com/… invite/conversation
	     links open the app (see public/.well-known/apple-app-site-association +
	     DeepLinkGate in src/App.tsx). Must match AppRelease.entitlements. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:dormcheck.com</string>
		<string>applinks:www.dormcheck.com</string>
	</array>
	<!-- Keychain Sharing: the host writes the Supabase session to the Keychain
	     (via @aparajita/capacitor-secure-storage / KeychainSwift, which stores
	     with no explicit access group, so items land in the app's DEFAULT group
	     = the FIRST entry below). Making that group the host app id lets the
	     MessagesExtension read the same item (see MessagesExtension.entitlements
	     + MessagesViewController.readSharedSupabaseSession). Removing the item on
	     sign-out clears it for both. This group MUST stay identical across App /
	     AppRelease / MessagesExtension entitlements. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.dormcheck.ios</string>
	</array>
</dict>
</plist>
