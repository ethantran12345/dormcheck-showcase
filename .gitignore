# E2E app-audit (Playwright) - see docs/app-bug-audit.md
.env.e2e
/playwright-report/
/test-results/
/test-results-*/
.playwright-mcp/
/docs/audits/app-bug-audit-report/
/.audit-app/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
dist
dist-ssr
build
*.local

# Design sync build artifacts (committed: design-sync.config.json, .design-sync/,
# ds-entry.ts). ds-entry.ts is tracked because it's hand-maintained: it drops the
# 7 curated-owned root names from window.DormcheckUI, and the converter derives
# its `exported` set from it upstream of every hook, so the exclusion can't live
# in config/overrides alone. package-build only READS it, so it isn't stomped by
# normal re-syncs; a full skill re-scaffold would regenerate it (git diff shows it).
.ds-sync/
ds-bundle/
ds-tailwind.css
index.d.ts
/types/
tsconfig.ds.json
.design-sync/.cache/
.design-sync/learnings/

# Local, regenerable code relationship map (never commit).
graphify-out/

# Environment variables - SECURITY CRITICAL
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
# Blanket catch so no env variant slips through (e.g. .env.local.bak leaked 2026-07-10).
.env*
# Committed, secret-free templates (placeholders only - never real values).
!.env.example
!.env.e2e.example

# Backup files - never commit; may contain secrets (see .env.local.bak leak 2026-07-10)
*.bak
# …including the DATED variant. `supabase` writes config.toml.bak-YYYYMMDD beside the
# gitignored config.toml, which `*.bak` does not match — so a backup of a secrets file sat
# untracked in the tree, and untracked dirt in the main worktree also blocks `lane:ship`.
*.bak-*

# Supabase configuration (may contain secrets)
supabase/.env
supabase/config.toml
supabase/.temp
supabase/.branches/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
Thumbs.db
.DS_Store
*.swp
*.swo
*~

# Testing
coverage
.nyc_output

# Misc
*.tsbuildinfo
.eslintcache

# iCloud-generated duplicate files
* [2-9].*
* [2-9][0-9].*

# iOS Capacitor build artifacts (regenerated by cap sync)
ios/App/App/public/assets/
ios/App/App/public/index.html
ios/App/App/config\ *.xml
supabase/snippets/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/DerivedData/
ios/App/build/

# Xcode per-user state (schemes, breakpoints - not shared)
**/xcuserdata/

# Claude Code per-user local settings
.claude/settings.local.json
public/e2e-route.txt
.vercel

# Local DB data backups (never commit — contains prod data/PII)
backups/

# transient tenant-isolation test screenshots (kept in scratchpad, never the repo)
tenant-*.png

# screenshot-sweep decision boards (board-390.png, board-level-card.png, …) — same
# class as tenant-*.png: regenerable artifacts of a sweep, written into the repo root.
# Two of them sat untracked in the main worktree on 2026-08-03 and blocked a lane:ship
# preflight, which reads any dirt in the main checkout as another writer's live work.
board-*.png

# screenshot sweeps (npm run sweep) — large, regenerable, and read live off disk
# by Command Center's Taste tab. The PATH is a contract; the contents never ship.
/.screenshots/

# Impeccable state. design.json and config.json ARE tracked: config.json is the
# SHARED detector config, so a waiver written there (e.g. the Fraunces
# ignore-value) reaches CI and every other agent instead of dying on one laptop.
# Anything machine-local — absolute paths into Ethan's personal vault — belongs
# in config.local.json, which must never be committed: live lanes run
# `git add -A`, which makes "merely untracked" not safe enough.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
