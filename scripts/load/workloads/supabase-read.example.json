{
  "thinkMs": 150,
  "requests": [
    {
      "name": "marketplace page",
      "method": "GET",
      "path": "/rest/v1/marketplace_listings?select=id,title,post_type,status,created_at&limit=50",
      "headers": {
        "apikey": "${LOAD_TEST_SUPABASE_KEY}",
        "Authorization": "Bearer ${LOAD_TEST_USER_JWT}"
      }
    },
    {
      "name": "notifications page",
      "method": "GET",
      "path": "/rest/v1/notifications?select=id,type,read,created_at&order=created_at.desc&limit=50",
      "headers": {
        "apikey": "${LOAD_TEST_SUPABASE_KEY}",
        "Authorization": "Bearer ${LOAD_TEST_USER_JWT}"
      }
    }
  ]
}
