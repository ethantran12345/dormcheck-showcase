# DormCheck environment template — placeholders only, NEVER real values.
# Copy to `.env.local` for local dev and fill in. Client vars are prefixed
# VITE_ and are bundled into the browser build (so they are PUBLIC by design).
# Real secrets (service-role key, Resend key, Turnstile SECRET) live only in
# Vercel/Supabase dashboards, never in any committed or local .env file.

# --- Supabase (client) ---
# REQUIRED. There is no fallback: src/integrations/supabase/client.ts throws if
# either is missing, and an env-guard Vite plugin aborts `npm run build` before
# bundling. Local stack: VITE_SUPABASE_URL=http://127.0.0.1:54321 and the anon key
# printed by `npx supabase start` (see .env.e2e.example). Hosted: Supabase
# dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Site / API ---
VITE_SITE_URL=http://localhost:8080
VITE_API_BASE_URL=https://dormcheck.com

# --- Maps ---
VITE_MAPBOX_TOKEN=pk.your-mapbox-token

# --- Affiliate ---
VITE_WALMART_PUBLISHER_ID=your-walmart-publisher-id

# --- Cloudflare Turnstile (captcha) ---
# PUBLIC site key for the Turnstile widget. Create a widget at
# dash.cloudflare.com → Turnstile (allowed hostnames: dormcheck.com, localhost).
# Must be present in EVERY environment (Vercel: all environments) BEFORE Supabase
# captcha enforcement is turned on, or auth calls will fail.
# The Turnstile SECRET is NOT here — it goes only in Supabase Auth → Attack
# Protection (provider = Turnstile). Leave this unset locally to disable the
# widget (auth works unchanged while Supabase enforcement is off).
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# --- Marketplace auto-moderation (edge-function secrets, NOT VITE_/client) ---
# Server-only keys for the image moderation edge functions.
# Set via `supabase secrets set` (local: also a supabase/functions/.env), never
# bundled into the client. If either is missing the function fails CLOSED, so a
# new listing stays hidden (pending_review) rather than auto-approving.
# OpenAI omni-moderation (stage 1, free) screens listing text + images:
OPENAI_API_KEY=sk-your-openai-key
# Claude Haiku (stage 3, cheap) judges only the scam-flagged minority:
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Vercel serverless functions (/api) — server-only, NEVER VITE_/client ---
# These are read by api/**. Set them in the Vercel dashboard (Settings →
# Environment Variables) for the deploying environment; locally they are only
# needed if you are exercising /api, which plain `vite` does not serve.
# Same project as VITE_SUPABASE_URL, without the VITE_ prefix:
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase dashboard → Project Settings → API → service_role. Bypasses RLS —
# never import this in client code and never prefix it VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Resend dashboard → API Keys. Transactional email (api/_lib/notifications.ts):
RESEND_API_KEY=re_your-resend-key
# Resend dashboard → Webhooks → signing secret. Verified via Svix in api/events.ts:
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret
# Generated locally (any long random string), then stored in Vercel. Signs the
# one-click unsubscribe links so they cannot be forged:
UNSUBSCRIBE_SECRET=your-unsubscribe-signing-secret
# Generated locally, then stored in Vercel. Guards /api/cron/* so only Vercel Cron
# can invoke the scheduled handlers:
CRON_SECRET=your-cron-secret
# Shared secret between api/_lib/push.ts and the `send-push` edge function. Generate
# once and set it in BOTH Vercel and `supabase secrets set` — they must match:
SEND_PUSH_AUTH_TOKEN=your-send-push-token

# --- Additional edge-function secrets (`supabase secrets set`, NOT client) ---
# Supabase dashboard → Authentication → Hooks. Verifies the send-email webhook
# signature in the `send-auth-email` function:
SEND_EMAIL_HOOK_SECRET=v1,whsec_your-auth-hook-secret
# CORS allowlist for the `admin-metrics` and moderation functions. Comma
# separated for ALLOWED_ORIGINS; both names are read, depending on the function:
ALLOWED_ORIGIN=https://dormcheck.com
ALLOWED_ORIGINS=https://dormcheck.com,http://localhost:8080
# Firebase console → Project settings → Service accounts → generate a private key.
# The whole JSON document on one line. Android push delivery:
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}
# Which Apple Push environment the `send-push` function targets: sandbox | production.
# Sandbox for TestFlight/debug builds, production for App Store builds:
APNS_ENV=sandbox
