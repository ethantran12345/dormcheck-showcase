# E2E app-audit test environment — TEMPLATE (committed, secret-free).
#
# Copy to `.env.e2e` (gitignored) to run `npm run audit:app` and the Simulator/dev
# auto-login flow. Points the app at the LOCAL Supabase stack — NEVER the prod project.
# The keys below are the well-known Supabase *local* demo keys (identical on every
# machine); they are NOT secrets and grant access only to the throwaway local stack.
# Regenerate the real `.env.e2e` with `npm run audit:app:db:up`.

# --- App client config (Vite reads VITE_* from the process env, overriding .env/.env.local) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Mapbox: dummy token keeps map components from throwing on boot; map tiles won't load (fine for crawl).
VITE_MAPBOX_TOKEN=pk.e2e.dummy
VITE_SITE_URL=http://localhost:8080

# --- Seeding (service_role, local only) ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Test accounts (seeded into the local stack by seed-test-users.mjs) ---
E2E_USER_EMAIL=e2e+user@pitt.edu
E2E_USER_PASSWORD=E2eUser!Passw0rd
E2E_ADMIN_EMAIL=e2e+admin@pitt.edu
E2E_ADMIN_PASSWORD=E2eAdmin!Passw0rd

# --- Simulator / dev auto-login (VITE_* so the client bundle can read them) ---
# Boots a local/e2e build already signed in as the seeded user, so verification
# never drives login through the UI. Guarded three ways (flag == 1, import.meta.env.DEV,
# and VITE_SUPABASE_URL is local); it is a hard no-op — and provably dead — in prod.
# See src/lib/e2eAutoLogin.ts. NEVER set VITE_E2E_AUTOLOGIN in a prod build.
VITE_E2E_AUTOLOGIN=1
VITE_E2E_EMAIL=e2e+user@pitt.edu
VITE_E2E_PASSWORD=E2eUser!Passw0rd
